{
  "builds": [
    { "src": "api/dispatch.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "logo-digital.png", "use": "@vercel/static" },
    { "src": "logo-mark.png", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/dispatch?__route=api/:path*" },
    { "source": "/avatars/:path*", "destination": "/api/dispatch?__route=avatars/:path*" }
  ]
}
